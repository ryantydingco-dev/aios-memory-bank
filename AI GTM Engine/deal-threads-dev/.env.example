PORT=4173
NODE_ENV=development

# Admin/CRM protection. Local development defaults to admin/deal-threads-local if
# ADMIN_PASSWORD is omitted. In production, set a strong password or protected
# routes will return 503.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=deal-threads-local

# Persistence. JSON is the default local mode. SQLite uses Node's built-in
# node:sqlite module and is better for a mounted Railway volume during beta.
DEAL_THREADS_DATA_STORE=json
DEAL_THREADS_DATA_FILE=.data/deal-threads-dev.json
DEAL_THREADS_SQLITE_FILE=.data/deal-threads-dev.sqlite

# Request payload cap. Keep this large enough for guarded state backup restore,
# but bounded for public widget/API protection.
MAX_REQUEST_BODY_BYTES=1048576

# Target cohort size for the first managed beta.
PILOT_TARGET_CLIENTS=5

# Optional: enables OpenAI structured extraction. Without this, the app uses
# the free heuristic extractor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# Optional: enables live HubSpot property setup and lead sync. Without this,
# HubSpot stays in safe stub/dry-run mode.
HUBSPOT_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

# internal = self-built website/domain enrichment.
# mock = deterministic local fallback.
ENRICHMENT_MODE=internal
INTERNAL_ENRICHMENT_TIMEOUT_MS=3500
INTERNAL_ENRICHMENT_SIGNAL_PAGE_LIMIT=2
PAID_ENRICHMENT_LOOKUP_ESTIMATE_USD=0.25
ENRICHMENT_REVIEW_CONFIDENCE_THRESHOLD=0.65

# Default report delivery mode records send attempts without transmitting
# external email. Use webhook only after you control the receiving workflow.
REPORT_EMAIL_MODE=dry_run
REPORT_EMAIL_FROM=reports@replede.local
REPORT_EMAIL_REPLY_TO=
ACTIVATION_NOTIFICATION_RECIPIENTS=
# When true, a valid public buyer confirmation creates/reuses the beta client,
# sends or dry-runs the launch packet, and redirects the buyer to /install/:token.
ACTIVATION_AUTO_KICKOFF_ON_CONFIRMATION=false
# When true, a public /install/:token tested URL submission immediately runs
# the same domain-safe source check operators can run from protected launch pages.
INSTALL_AUTO_SOURCE_CHECK_ON_HANDOFF=false
REPORT_EMAIL_WEBHOOK_URL=
REPORT_EMAIL_WEBHOOK_TOKEN=

# Default CRM delivery mode records send attempts without posting externally.
# Use webhook only after you control the receiving workflow.
CRM_DELIVERY_MODE=dry_run
CRM_DELIVERY_WEBHOOK_URL=
CRM_DELIVERY_WEBHOOK_TOKEN=
